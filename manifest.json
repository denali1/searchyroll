{
  "manifest_version": 3,
  "name": "Searchyroll",
  "version": "0.1.0",
  "description": "Unified search across Crunchyroll and Hidive — cross-platform genre, dub, and availability filtering in one anime search overlay.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "*://*.crunchyroll.com/*",
    "*://*.hidive.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["*://*.crunchyroll.com/*"],
      "js": ["content-cr.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.hidive.com/*"],
      "js": ["content-hidive.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [],

  "browser_specific_settings": {
    "gecko": {
      "id": "searchyroll@denali1",
      "strict_min_version": "128.0"
    }
  }
}